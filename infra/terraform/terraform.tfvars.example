# Copy to terraform.tfvars and adjust as needed, or rely on the defaults in variables.tf.
project      = "teachtracker"
github_owner = "budhap-dev"
github_repo  = "func-teaching-tracker"

# One Function App + OIDC identity is created per environment.
# Keys MUST match the GitHub Environment names in .github/workflows/deploy.yml.
environments = {
  dev = {
    location     = "eastus"
    node_version = "24"
    # After the frontend Static Web Apps exist, set each env's allowed origin
    # to its paired SWA URL (from the frontend `static_web_app_urls` output):
    # cors_allowed_origins = ["https://swa-teachtracker-dev.azurestaticapps.net"]
  }
  prod = {
    location               = "eastus"
    node_version           = "24"
    maximum_instance_count = 100
    # cors_allowed_origins = ["https://swa-teachtracker-prod.azurestaticapps.net"]
  }
}

# REQ-004: the teacher allow-list. Seeds the Key Vault secret 'teacher-emails'
# per environment; add/remove teachers later by editing the secret directly.
# teacher_emails = ["teacher@example.com"]
